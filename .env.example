# HubSpot - get from https://app.hubspot.com/developer -> your app -> Auth
HUBSPOT_API_KEY=your_hubspot_private_app_token_here
# Or use OAuth, but private app token is simplest for demo

# OpenAI / GPT-6 Sol compatible (optional - if not set, uses mock classifier)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# For GPT-6 Sol you would use: model=gpt-6-sol, base_url=https://...

# Telegram for manager notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_manager_chat_id

# App
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Europe/Tallinn

# CRM settings
HUBSPOT_DEAL_PIPELINE=default
DEAL_STAGE=appointmentscheduled
